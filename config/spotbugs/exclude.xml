<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude generated code -->
    <Match>
        <Class name="~.*\.generated\..*"/>
    </Match>
    
    <!-- Exclude test classes -->
    <Match>
        <Class name="~.*\.*Test"/>
    </Match>
    
    <!-- Exclude specific packages if needed -->
    <!-- 
    <Match>
        <Package name="com.example.generated"/>
    </Match>
    -->
</FindBugsFilter>