public static void printAsciiChart(float[] lows, float[] highs) {
    if (lows.length != highs.length || lows.length == 0) {
        System.out.println("Invalid data");
        return;
    }

    int width = lows.length;
    float minLow = java.util.Arrays.stream(lows).min().orElse(0);
    float maxHigh = java.util.Arrays.stream(highs).max().orElse(100);
    float range = maxHigh - minLow;

    // Высота графика в строках
    int height = 20;

    // Создаем матрицу для отображения
    char[][] grid = new char[height][width];
    for (int i = 0; i < height; i++) {
        for (int j = 0; j < width; j++) {
            grid[i][j] = ' ';
        }
    }

    // Отмечаем high и low
    for (int i = 0; i < width; i++) {
        float lowNorm = (lows[i] - minLow) / range;
        float highNorm = (highs[i] - minLow) / range;

        int lowY = height - 1 - (int)(lowNorm * (height - 1));
        int highY = height - 1 - (int)(highNorm * (height - 1));

        // Ограничиваем значения
        lowY = Math.max(0, Math.min(height - 1, lowY));
        highY = Math.max(0, Math.min(height - 1, highY));

        // Рисуем вертикальную линию от low до high
        for (int y = Math.min(lowY, highY); y <= Math.max(lowY, highY); y++) {
            if (y >= 0 && y < height && i < width) {
                grid[y][i] = '|';
            }
        }

        // Отмечаем точки касаний или пробоев (можно добавить позже)
        // Например, если это точка касания fibo382/fibo618
    }

    // Выводим график
    System.out.println("\n--- ASCII Chart ---");
    for (int y = 0; y < height; y++) {
        System.out.print(String.format("%6.1f ", maxHigh - (y * range / (height - 1))));
        for (int x = 0; x < width; x++) {
            System.out.print(grid[y][x]);
        }
        System.out.println();
    }

    // Подпись оси X
    System.out.print("        ");
    for (int i = 0; i < width; i++) {
        System.out.print("-");
    }
    System.out.println();

    System.out.print("        ");
    for (int i = 0; i < width; i++) {
        if (i % 5 == 0) {
            System.out.printf("%-5d", i);
        } else {
            System.out.print(" ");
        }
    }
    System.out.println("\n");
}